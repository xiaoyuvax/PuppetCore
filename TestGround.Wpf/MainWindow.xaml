<Window x:Class="TestGround.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TestGround.Wpf"
        Title="{loc:Tr Zh='页间 · 阅读清单', En='Reading Room · Reading list'}" Width="860" Height="650" MinWidth="720" MinHeight="590"
        WindowStartupLocation="CenterScreen" Background="#F4F3EE" Foreground="#253E3A"
        FontFamily="Microsoft YaHei UI" FontSize="14" UseLayoutRounding="True"
        AutomationProperties.Name="{loc:Tr Zh='页间阅读清单', En='Reading Room reading list'}">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Background" Value="#E2ECE6" />
            <Setter Property="Foreground" Value="#253E3A" />
            <Setter Property="BorderBrush" Value="#8AABA0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#A5B8B0" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,0,0,6" />
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Foreground" Value="#387768" />
            <Setter Property="Background" Value="#E4EAE5" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        </Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="{loc:Tr Zh='页间', En='Reading Room'}" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Tr Zh='READING ROOM  /  每一页，都是向前的一小步。', En='READING ROOM  /  Every page is one small step forward.'}" Foreground="#536A62" Margin="0,4,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <Label Content="{loc:Tr Zh='书名 (_T)', En='Title (_T)'}" Target="{Binding ElementName=TitleBox}" />
                    <TextBox x:Name="TitleBox" Text="{Binding TitleInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="{loc:Tr Zh='书名', En='Title'}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <Label Content="{loc:Tr Zh='总页数 (_P)', En='Total pages (_P)'}" Target="{Binding ElementName=TotalBox}" />
                    <TextBox x:Name="TotalBox" Text="{Binding TotalInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" AutomationProperties.Name="{loc:Tr Zh='总页数，1 到 100000', En='Total pages, 1 to 100000'}" />
                </StackPanel>
                <Button x:Name="AddButton" Grid.Column="2" Content="{loc:Tr Zh='加入书架 (_A)', En='Add to shelf (_A)'}" Click="AddClicked" VerticalAlignment="Bottom" />
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                <TextBlock Text="{Binding AggregateText}" Margin="0,0,0,8" />
                <ProgressBar Value="{Binding OverallProgress, Mode=OneWay}" AutomationProperties.Name="{loc:Tr Zh='全部书籍按页数加权的阅读进度', En='Reading progress of all books weighted by pages'}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Label Content="{loc:Tr Zh='筛选 (_F)', En='Filter (_F)'}" Target="{Binding ElementName=FilterBox}" VerticalAlignment="Center" Padding="0,0,8,0" />
                <ComboBox x:Name="FilterBox" Width="100" Padding="7" ItemsSource="{Binding Filters}" SelectedValue="{Binding Filter, Mode=TwoWay}" SelectedValuePath="Value" DisplayMemberPath="Label" AutomationProperties.Name="{loc:Tr Zh='阅读状态筛选', En='Reading status filter'}" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding ShelfHeader}" FontWeight="SemiBold" Margin="4,0,0,10" />
                    <ListBox x:Name="BookList" Grid.Row="1" ItemsSource="{Binding Books}" SelectedItem="{Binding SelectedBook}" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{loc:Tr Zh='书架，使用方向键选择书籍', En='Shelf; use the arrow keys to select a book'}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding PageSummary}" FontSize="12" Foreground="#536A62" Margin="0,5,0,7" />
                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Height="5" AutomationProperties.Name="{loc:Tr Zh='本书阅读进度', En='Reading progress of this book'}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="1" Text="{Binding EmptyShelfText}" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="#536A62">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VisibleCount}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="#E7EEE8" CornerRadius="10" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Zh='阅读进度', En='Reading progress'}" FontSize="12" Foreground="#536A62" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding SelectedTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectionSummary}" TextWrapping="Wrap" Margin="0,8,0,12" />
                        <ProgressBar Value="{Binding SelectedProgress, Mode=OneWay}" AutomationProperties.Name="{loc:Tr Zh='所选书籍阅读进度', En='Reading progress of the selected book'}" />
                        <Label Content="{loc:Tr Zh='已读到第几页 (_R)', En='Read up to page (_R)'}" Target="{Binding ElementName=ReadBox}" Margin="0,16,0,0" />
                        <TextBox x:Name="ReadBox" Text="{Binding ReadInput, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HasSelection}" MaxLength="10" AutomationProperties.Name="{loc:Tr Zh='已读页数，从零到总页数', En='Pages read, from zero to total pages'}" />
                        <Button x:Name="SaveButton" Content="{loc:Tr Zh='更新进度 (_U)', En='Update progress (_U)'}" Click="SaveClicked" IsEnabled="{Binding HasSelection}" />
                        <Button x:Name="RemoveButton" Content="{loc:Tr Zh='移除书籍 (_D)', En='Remove book (_D)'}" Click="RemoveClicked" IsEnabled="{Binding HasSelection}" Background="White" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{Binding AgentStatus}" FontSize="11" Foreground="#536A62" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
