<Project>
	<PropertyGroup>
		<Authors>Xiaoyuvax</Authors>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<LangVersion>12.0</LangVersion>
		<InvariantGlobalization>true</InvariantGlobalization>
		<ImplicitUsings>enable</ImplicitUsings>
		<DebugAot>false</DebugAot>
		<DefineConstants Condition="'$(PublishAot)'=='true' Or '$(DebugAot)'=='true'">$(DefineConstants);NativeAOT</DefineConstants>
		<IsAotCompatible>true</IsAotCompatible>
		<TrimmerRootAssembly>$(AssemblyName)</TrimmerRootAssembly>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<Version>1.2.5</Version>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
		<Description>Puppet Agent 操控框架</Description>
	</PropertyGroup>
</Project>
